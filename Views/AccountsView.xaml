<UserControl x:Class="GeLiLauncher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Sub}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="13,6" Background="{DynamicResource SoftBg}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SoftBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource GreenDark}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 账号列表 -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="账号" Style="{StaticResource H1}" FontSize="21" />
                    <TextBlock Text="正版账号启动时会校验游戏拥有权；离线档案仅用于单人 / 离线服务器"
                               Style="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel x:Name="AcctList" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 添加账号 -->
        <Border Grid.Column="1" Width="386" Margin="14,0,0,0" Style="{StaticResource GlassCard}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="添加账号" Style="{StaticResource H2}" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <RadioButton x:Name="TabMs" Content="微软正版" Style="{StaticResource TabChip}" GroupName="acc"
                                 IsChecked="True" Checked="OnTabChanged" />
                    <RadioButton x:Name="TabOff" Content="离线档案" Style="{StaticResource TabChip}" GroupName="acc"
                                 Checked="OnTabChanged" />
                    <RadioButton x:Name="TabAli" Content="外置登录" Style="{StaticResource TabChip}" GroupName="acc"
                                 Checked="OnTabChanged" />
                </StackPanel>

                <!-- 微软 -->
                <StackPanel x:Name="PaneMs" Margin="0,16,0,0">
                    <Border CornerRadius="10" Background="{DynamicResource SoftBg}" Padding="12,10">
                        <TextBlock x:Name="MsNote" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{DynamicResource Sub}"
                                   Text="点击下方按钮会打开内嵌的微软官方登录页。登录全程在微软页面完成，启动器不会接触你的密码，登录成功后会自动校验游戏拥有权。" />
                    </Border>

                    <TextBlock x:Name="MsStatus" Text="" Style="{DynamicResource Muted}" Margin="0,12,0,0"
                               TextWrapping="Wrap" />

                    <Button x:Name="BtnMsLogin" Content="打开登录窗口" Style="{StaticResource BtnPrimary}"
                            Margin="0,14,0,0" Padding="16,11" Click="OnMsLogin" />
                    <Button x:Name="BtnMsCancel" Content="取消登录" Style="{StaticResource BtnGhost}"
                            Margin="0,6,0,0" Padding="14,8" Click="OnMsCancel" Visibility="Collapsed" />
                </StackPanel>

                <!-- 外置登录 -->
                <StackPanel x:Name="PaneAli" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="认证服务器" Style="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,6" />
                    <TextBox x:Name="AliServer" Padding="10,9" Text="https://littleskin.cn/api/yggdrasil" />
                    <TextBlock Text="支持 LittleSkin 等 Yggdrasil 认证服务器，填服务器地址或只填域名都行"
                               Style="{DynamicResource Muted}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="邮箱 / 账号" Style="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,6" />
                    <TextBox x:Name="AliEmail" Padding="10,9" />

                    <TextBlock Text="密码" Style="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,6" />
                    <PasswordBox x:Name="AliPwd" Padding="10,9" />

                    <Button x:Name="BtnAliLogin" Content="登录" Style="{StaticResource BtnPrimary}" Margin="0,16,0,0"
                            Padding="16,11" Click="OnAuthlibLogin" />
                    <TextBlock x:Name="AliStatus" Style="{DynamicResource Muted}" FontSize="10.5"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 离线 -->
                <StackPanel x:Name="PaneOff" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock Text="游戏内名称" Style="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,6" />
                    <TextBox x:Name="OffName" Padding="10,9" MaxLength="16" />
                    <TextBlock Text="3–16 位字母、数字或下划线。离线档案没有正版身份，只能进单人游戏或允许离线登录的服务器。"
                               Style="{DynamicResource Muted}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Button Content="添加离线档案" Style="{StaticResource BtnBlue}" Margin="0,14,0,0"
                            Padding="16,11" Click="OnAddOffline" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
