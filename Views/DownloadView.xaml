<UserControl x:Class="GeLiLauncher.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Sub}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="11,5" Background="{DynamicResource SoftBg}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SoftBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLine}" />
                                <Setter Property="Foreground" Value="{DynamicResource GreenDark}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoaderCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{DynamicResource Line}" Background="{DynamicResource GlassBrush}"
                                Padding="11,9" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="lift" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="-1.5" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGlassBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Margin="2,0,2,0">
            <StackPanel>
                <TextBlock Text="下载" Style="{StaticResource H1}" FontSize="21" />
                <TextBlock x:Name="SubNote" Text="游戏版本、模组、光影与下载任务，都在这一页"
                           Style="{DynamicResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}"
                    Background="{DynamicResource AccentSoft}" Padding="10,4">
                <TextBlock x:Name="TopSourceTag" Text="数据源：Modrinth" FontSize="11"
                           Foreground="{DynamicResource GreenDark}" />
            </Border>
        </Grid>

        <!-- 分类 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,14,0,14">
            <RadioButton x:Name="TabVersion" Content="游戏版本" Style="{StaticResource Chip}" GroupName="dltab"
                         IsChecked="True" Checked="OnTabChanged" Tag="version" />
            <RadioButton x:Name="TabMod" Content="Mod" Style="{StaticResource Chip}" GroupName="dltab"
                         Checked="OnTabChanged" Tag="mod" />
            <RadioButton x:Name="TabModpack" Content="整合包" Style="{StaticResource Chip}" GroupName="dltab"
                         Checked="OnTabChanged" Tag="modpack" />
            <RadioButton x:Name="TabDatapack" Content="数据包" Style="{StaticResource Chip}" GroupName="dltab"
                         Checked="OnTabChanged" Tag="datapack" />
            <RadioButton x:Name="TabResourcepack" Content="资源包" Style="{StaticResource Chip}" GroupName="dltab"
                         Checked="OnTabChanged" Tag="resourcepack" />
            <RadioButton x:Name="TabShader" Content="光影包" Style="{StaticResource Chip}" GroupName="dltab"
                         Checked="OnTabChanged" Tag="shader" />
            <RadioButton x:Name="TabTasks" Content="下载任务" Style="{StaticResource Chip}" GroupName="dltab"
                         Checked="OnTabChanged" Tag="tasks" />
        </StackPanel>

        <Grid Grid.Row="2">
        <Grid x:Name="VersionPane">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============ 版本列表 ============ -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="选择游戏版本" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <Button Content="刷新清单" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                            Padding="9,3" FontSize="11.5" Click="OnReloadManifest" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,13,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="FRelease" Content="正式版" Style="{StaticResource Chip}" GroupName="vf"
                                     IsChecked="True" Checked="OnFilterChanged" />
                        <RadioButton x:Name="FSnapshot" Content="快照" Style="{StaticResource Chip}" GroupName="vf"
                                     Checked="OnFilterChanged" />
                        <RadioButton x:Name="FAll" Content="全部" Style="{StaticResource Chip}" GroupName="vf"
                                     Checked="OnFilterChanged" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0" Padding="9,6"
                             TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索版本号，如 1.21.4"
                               Foreground="{DynamicResource Sub}" FontSize="12" Margin="19,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <ListBox x:Name="VerList" Grid.Row="2" Style="{StaticResource CleanList}"
                         ItemContainerStyle="{StaticResource VersionItem}"
                         SelectionChanged="OnVersionSelected" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Id}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DateText}" Style="{DynamicResource Muted}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="ListStatus" Grid.Row="3" Text="正在读取版本清单…" Style="{DynamicResource Muted}"
                           FontSize="11" Margin="2,8,0,0" />
            </Grid>
        </Border>

        <!-- ============ 安装面板 ============ -->
        <Border Grid.Column="1" Style="{StaticResource GlassCard}" Width="356" Margin="14,0,0,0" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="安装设置" Style="{StaticResource H2}" />
                    <TextBlock x:Name="SelVersionText" Text="先在左侧选择一个版本" Style="{DynamicResource Muted}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="模组加载器" Style="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,8" />

                    <UniformGrid Columns="2">
                        <RadioButton x:Name="LVanilla" Style="{StaticResource LoaderCard}" GroupName="loader" IsChecked="True"
                                     Margin="0,0,4,4" Checked="OnLoaderChanged">
                            <StackPanel>
                                <TextBlock Text="原版" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="纯净官方版本" Style="{DynamicResource Muted}" FontSize="10.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LFabric" Style="{StaticResource LoaderCard}" GroupName="loader"
                                     Margin="4,0,0,4" Checked="OnLoaderChanged">
                            <StackPanel>
                                <TextBlock Text="Fabric" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="轻量，生态活跃" Style="{DynamicResource Muted}" FontSize="10.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LForge" Style="{StaticResource LoaderCard}" GroupName="loader"
                                     Margin="0,4,4,0" Checked="OnLoaderChanged">
                            <StackPanel>
                                <TextBlock Text="Forge" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="整合包兼容最好" Style="{DynamicResource Muted}" FontSize="10.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LNeoForge" Style="{StaticResource LoaderCard}" GroupName="loader"
                                     Margin="4,4,0,0" Checked="OnLoaderChanged">
                            <StackPanel>
                                <TextBlock Text="NeoForge" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="Forge 的新分支" Style="{DynamicResource Muted}" FontSize="10.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <StackPanel x:Name="LoaderVerPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="LoaderVerLabel" Text="加载器版本" Style="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox x:Name="LoaderVerBox" DisplayMemberPath="Version" />
                    </StackPanel>

                    <TextBlock x:Name="LoaderHint" Style="{DynamicResource Muted}" FontSize="10.5"
                               Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <!-- 安装进度 -->
                <StackPanel x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,16,0,0">
                    <ProgressBar x:Name="InstallBar" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="InstallStep" Text="准备中…" Style="{DynamicResource Muted}" FontSize="11"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,16,0,0">
                    <Border CornerRadius="10" Background="{DynamicResource SoftBg}" Padding="11,9">
                        <StackPanel>
                            <TextBlock Text="下载加速" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BlueDark}" />
                            <TextBlock x:Name="SourceNote" Text="当前：自动选择最快源" Style="{DynamicResource Muted}"
                                       FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="BtnInstall" Grid.Row="4" Content="开始安装" Style="{StaticResource BtnPrimary}"
                        Padding="18,11" FontSize="13.5" Margin="0,12,0,0" Click="OnInstall" IsEnabled="False" />
            </Grid>
        </Border>
        </Grid>

            <!-- 模组 / 整合包 / 下载任务：复用现成页面 -->
            <ContentControl x:Name="EmbedHost" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
