<UserControl x:Class="GeLiLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GeLiLauncher.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">

            <!-- 当前版本 -->
            <Border Style="{StaticResource GlassCard}" Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="当前版本" Style="{DynamicResource Muted}" FontSize="11.5" />
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border x:Name="InstIcon" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                    Background="{DynamicResource SoftBg}" VerticalAlignment="Center"
                                    ClipToBounds="True" Visibility="Collapsed">
                                <Grid x:Name="InstIconHost" />
                            </Border>
                            <TextBlock x:Name="InstName" Text="尚未安装版本" Style="{StaticResource H1}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
                            <Border x:Name="TagLoader" Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Margin="10,0,0,0">
                                <TextBlock x:Name="TagLoaderText" Text="原版" FontSize="11" Foreground="{DynamicResource GreenDark}" />
                            </Border>
                            <Border x:Name="TagMc" Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Margin="6,0,0,0">
                                <TextBlock x:Name="TagMcText" Text="—" FontSize="11" Foreground="{DynamicResource BlueDark}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock x:Name="InstSub" Text="安装一个版本后即可开始游戏" Style="{DynamicResource Muted}"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Cursor="Hand"
                                   MouseLeftButtonUp="OnOpenGameDir" />

                        <StackPanel Margin="0,20,0,0">
                            <!-- 主操作一行，次要操作放第二行，避免挤到右边的账号卡 -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnPlay" Content="启动游戏" Style="{StaticResource BtnPrimary}"
                                        Padding="36,13" FontSize="15" FontWeight="SemiBold" Click="OnPlay" />
                                <Button Content="版本选择" Style="{StaticResource BtnSoft}" Margin="10,0,0,0"
                                        Padding="18,12" Click="OnSwitchVersion" />
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="新建版本" Style="{StaticResource BtnGhost}"
                                        Padding="14,8" FontSize="12.5" Click="OnNewVersion" />
                                <Button Content="导入整合包" Style="{StaticResource BtnGhost}" Margin="2,0,0,0"
                                        Padding="14,8" FontSize="12.5" Click="OnImportModpack" />
                                <TextBlock x:Name="InstCountText" Style="{StaticResource Muted}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 账号 -->
                    <Border Grid.Column="1" CornerRadius="12" Background="{DynamicResource SoftBg}" Padding="16,14" Width="212"
                            VerticalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="当前账号" Style="{DynamicResource Muted}" FontSize="11" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border x:Name="AccAvatar" Width="34" Height="34" CornerRadius="17"
                                        Background="{DynamicResource Green}">
                                    <TextBlock x:Name="AccAvatarText" Text="?" Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccName" Text="未登录" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="AccType" Text="—" Style="{DynamicResource Muted}" FontSize="10.5" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="管理账号" Style="{StaticResource BtnBase}" Margin="0,14,0,0" Padding="10,6"
                                    FontSize="12" Click="OnManageAccount" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>


            <!-- 运行环境 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,4" Padding="18,16" Background="{DynamicResource SoftBg}" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="Java 运行时" Style="{DynamicResource Muted}" FontSize="10.5" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="JavaText" Text="检测中…" FontSize="12.5" FontWeight="SemiBold" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="内存分配" Style="{DynamicResource Muted}" FontSize="10.5" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="MemText" Text="—" FontSize="12.5" FontWeight="SemiBold" Margin="0,5,0,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Sub}" VerticalAlignment="Center" />
                            <TextBlock Text="下载源" Style="{DynamicResource Muted}" FontSize="10.5" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SrcText" Text="—" FontSize="12.5" FontWeight="SemiBold" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <!-- 皮肤 3D 预览 -->
            <Border Grid.Column="1" Width="322" VerticalAlignment="Center" Style="{StaticResource GlassCard}"
                    Padding="16,14">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="皮肤预览" Style="{StaticResource H2}" />
                            <TextBlock x:Name="SkinName" Text="—" Style="{StaticResource Muted}" FontSize="10.5"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Content="刷新" Style="{StaticResource BtnSm}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Padding="12,4" Click="OnRefreshSkin" />
                    </Grid>

                    <Border Height="304" Margin="0,10,0,0" CornerRadius="12"
                            Background="{DynamicResource SoftBg}" ClipToBounds="True">
                        <Grid>
                            <local:SkinView3D x:Name="Skin3D" />

                            <!-- 软件渲染下 WPF 的 3D 不工作，改用 2D 皮肤图兜底（远控时会走到这里） -->
                            <Grid x:Name="Skin2DPane" Visibility="Collapsed" Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image x:Name="Skin2DImage" Grid.Row="0" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock Grid.Row="1" Text="兼容渲染模式：显示皮肤展开图"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"
                                           FontSize="10" Style="{StaticResource Muted}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="DragHint" Text="拖动旋转" Style="{StaticResource Muted}" FontSize="10"
                                   VerticalAlignment="Center" />
                        <Button Content="本地皮肤…" Style="{StaticResource BtnSm}" HorizontalAlignment="Right"
                                Padding="12,4" Click="OnPickSkin" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
