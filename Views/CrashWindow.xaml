<Window x:Class="GeLiLauncher.Views.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="崩溃分析" Width="760" Height="620" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="崩溃分析" Style="{StaticResource H1}" FontSize="20" />
            <TextBlock x:Name="SubText" Text="—" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>

        <!-- 直接原因 -->
        <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="10" Padding="14,11"
                Background="{DynamicResource SoftBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="直接原因" FontSize="11" Foreground="{DynamicResource Sub}" />
                <TextBlock x:Name="HeadlineText" Text="—" FontSize="12.5" Margin="0,6,0,0"
                           TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono, monospace" />
            </StackPanel>
        </Border>

        <!-- 建议 -->
        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="10" Padding="14,11"
                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="可能的原因与处理办法" FontSize="11" Foreground="{DynamicResource AccentDark}" />
                <StackPanel x:Name="HintPanel" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 日志片段 -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="10" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ExcerptText" Text="—" FontSize="11" TextWrapping="NoWrap"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           Foreground="{DynamicResource Sub}" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathText" Style="{StaticResource Muted}" FontSize="10"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打开报告" Style="{StaticResource BtnSoft}" Padding="14,6" FontSize="12"
                        Click="OnOpenReport" />
                <Button Content="打开版本目录" Style="{StaticResource BtnGhost}" Padding="14,6" FontSize="12"
                        Margin="6,0,0,0" Click="OnOpenInstance" />
                <Button Content="关闭" Style="{StaticResource BtnPrimary}" Padding="18,6" FontSize="12"
                        Margin="10,0,0,0" Click="OnClose" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
