<UserControl x:Class="GeLiLauncher.Views.VersionPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <UserControl.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="9" Background="Transparent" Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SoftBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLine}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 二级页面标题栏 -->
        <Grid Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="← 返回" Style="{StaticResource BtnGhost}" Padding="8,5" FontSize="12.5"
                        Click="OnBack" />
                <TextBlock Text="版本选择" Style="{StaticResource H1}" FontSize="21" Margin="10,0,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}"
                    Background="{DynamicResource AccentSoft}" Padding="10,4">
                <TextBlock x:Name="CountTag" Text="—" FontSize="11" Foreground="{DynamicResource AccentDark}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 文件夹列表 -->
            <Border Grid.Column="0" CornerRadius="14" Background="{DynamicResource SoftBg}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="游戏文件夹" Style="{StaticResource Muted}" FontSize="11" Margin="6,2,0,8" />

                    <ListBox x:Name="DirList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnDirChanged" />

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="＋ 添加文件夹" Style="{StaticResource BtnSoft}"
                                Padding="12,8" HorizontalAlignment="Stretch" Click="OnAddDir" />
                        <TextBlock Text="也可以把文件夹拖进来" Style="{StaticResource Muted}"
                                   FontSize="10" Margin="6,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 版本分组 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel x:Name="GroupPanel" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
