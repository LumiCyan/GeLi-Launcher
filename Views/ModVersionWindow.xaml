<Window x:Class="GeLiLauncher.Views.ModVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择版本" Width="880" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="选择版本" Style="{StaticResource H1}" FontSize="19" />
                <TextBlock x:Name="SubText" Text="—" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="关闭" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Padding="12,5" Click="OnClose" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="OnlyMatchBox" Content="只显示匹配当前版本" IsChecked="True" Click="OnFilterChanged" />
                <ComboBox x:Name="GameVerBox" Width="150" Margin="16,0,0,0" SelectionChanged="OnFilterChanged" />
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="10.5"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel x:Name="ListHost" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
