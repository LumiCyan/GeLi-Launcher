<UserControl x:Class="GeLiLauncher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,0">
            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="搜索 Mod" Style="{StaticResource H1}" FontSize="21" />
                <TextBlock x:Name="ScopeText" Text="按当前实例的版本与加载器筛选" Style="{DynamicResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Padding="10,4">
                <TextBlock x:Name="SourceTag" Text="数据源：Modrinth" FontSize="11" Foreground="{DynamicResource BlueDark}" />
            </Border>
        </Grid>

        <!-- 搜索条件 -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="18,15" Margin="0,14,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="236" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左：名称 / 版本 -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="名称" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Sub}" />
                    <Grid Margin="46,0,0,0">
                        <TextBox x:Name="SearchBox" Padding="10,8" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                        <TextBlock x:Name="SearchHint" Text="支持中文（如：小地图、光影、物品管理器）"
                                   Foreground="{DynamicResource Sub}" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                    <TextBlock Text="版本" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Sub}" />
                    <ComboBox x:Name="VerBox" Margin="46,0,0,0" Padding="8,6" IsEditable="True"
                              SelectionChanged="OnFilterChanged" />
                </Grid>

                <!-- 右：来源 / 类型 -->
                <Grid Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="来源" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Sub}" />
                    <ComboBox x:Name="SrcBox" Margin="46,0,0,0" Padding="8,6" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="全部" Tag="auto" />
                        <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                        <ComboBoxItem Content="CurseForge" Tag="curseforge" />
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                    <TextBlock Text="类型" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Sub}" />
                    <ComboBox x:Name="TypeBox" Margin="46,0,0,0" Padding="8,6" SelectedIndex="0" SelectionChanged="OnTypeChanged">
                        <ComboBoxItem Content="Mod" Tag="mod" />
                        <ComboBoxItem Content="整合包" Tag="modpack" />
                        <ComboBoxItem Content="数据包" Tag="datapack" />
                        <ComboBoxItem Content="资源包" Tag="resourcepack" />
                        <ComboBoxItem Content="光影包" Tag="shader" />
                    </ComboBox>
                </Grid>

                <!-- 按钮 -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnSearch" Content="搜索" Style="{StaticResource BtnPrimary}"
                            Padding="34,9" Click="OnSearch" />
                    <Button Content="重置条件" Style="{StaticResource BtnSoft}" Margin="10,0,0,0"
                            Padding="24,9" Click="OnReset" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <WrapPanel x:Name="ModWrap" />
        </ScrollViewer>
    </Grid>
</UserControl>
