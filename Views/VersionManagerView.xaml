<UserControl x:Class="GeLiLauncher.Views.VersionManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="← 返回" Style="{StaticResource BtnGhost}" Padding="8,5" FontSize="12.5"
                        Click="OnBack" />
                <TextBlock Text="版本管理" Style="{StaticResource H1}" FontSize="21" Margin="10,0,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}"
                    Background="{DynamicResource SoftBg}" Padding="10,4">
                <TextBlock x:Name="DirTag" Text="—" FontSize="11" Foreground="{DynamicResource Sub}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="打开 versions 文件夹" Style="{StaticResource BtnSoft}" Padding="14,6" FontSize="12"
                        Click="OnOpenFolder" />
                <Button Content="刷新" Style="{StaticResource BtnGhost}" Padding="12,6" FontSize="12"
                        Margin="6,0,0,0" Click="OnRefresh" />
                <TextBlock Style="{DynamicResource Muted}" FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="删除版本会连同 mods 和存档一起删掉，建议先备份" />
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{DynamicResource Muted}" FontSize="10.5"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" CornerRadius="14" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel x:Name="ListHost" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
