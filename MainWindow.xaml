<Window x:Class="GeLiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeLiLauncher.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GeLi Launcher" Height="768" Width="1200" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True"
        Icon="Assets/gll.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource WindowBgBrush}">

        <!-- 背景图（用户在「个性化」里设置的） -->
        <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="BgTint" Background="Transparent" IsHitTestVisible="False" />

        <!-- 背景光斑：玻璃质感来源 -->
        <Ellipse Width="520" Height="520" Fill="{DynamicResource GlowBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-240,-160,0" IsHitTestVisible="False">
            <Ellipse.Opacity>0.16</Ellipse.Opacity>
        </Ellipse>
        <Ellipse Width="560" Height="560" Fill="{DynamicResource GlowBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-220,0,0,-260" IsHitTestVisible="False">
            <Ellipse.Opacity>0.14</Ellipse.Opacity>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/gll.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="GeLi Launcher" Margin="9,0,0,0" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Margin="9,0,0,0" Padding="6,1">
                        <TextBlock Text="2.0" FontSize="10.5" Foreground="{DynamicResource GreenDark}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Width="46" Height="32" Margin="0,0,2,0"
                            Style="{StaticResource BtnGhost}" Click="OnMinimize" ToolTip="最小化">
                        <local:IconView Kind="min" Width="14" Height="14" />
                    </Button>
                    <Button x:Name="BtnMax" Width="46" Height="32" Margin="0,0,2,0"
                            Style="{StaticResource BtnGhost}" Click="OnMaximize" ToolTip="最大化">
                        <local:IconView Kind="max" Width="13" Height="13" />
                    </Button>
                    <Button x:Name="BtnClose" Width="46" Height="32" Margin="0,0,8,0"
                            Style="{StaticResource BtnGhost}" Click="OnClose" ToolTip="关闭">
                        <local:IconView Kind="close" Width="13" Height="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧栏 -->
                <Grid Grid.Column="0" Margin="12,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 侧栏底板：亮一层，和右边的内容区分开 -->
                    <Border Grid.RowSpan="2" CornerRadius="14" BorderThickness="0"
                            Background="{DynamicResource GlassBrush}"
                            Effect="{DynamicResource CardShadowEffect}" />

                    <StackPanel Grid.Row="0" Margin="10,12,10,6">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavBtn}" IsChecked="True" GroupName="nav"
                                     Checked="OnNavChecked" Click="OnNavClick" Tag="home">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Kind="home" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="主页" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDownload" Style="{StaticResource NavBtn}" GroupName="nav"
                                     Checked="OnNavChecked" Click="OnNavClick" Tag="download">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Kind="download" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="下载" Margin="11,0,0,0" VerticalAlignment="Center" />
                                <Border x:Name="DlBadge" Visibility="Collapsed" CornerRadius="7" Padding="5,0,5,0"
                                        Margin="7,0,0,0" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                                    <TextBlock x:Name="DlBadgeText" Text="0" FontSize="9.5" Foreground="White" />
                                </Border>

                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavVersions" Style="{StaticResource NavBtn}" GroupName="nav"
                                     Checked="OnNavChecked" Click="OnNavClick" Tag="versions">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Kind="versions" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="版本管理" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavContent" Style="{StaticResource NavBtn}" GroupName="nav"
                                     Checked="OnNavChecked" Click="OnNavClick" Tag="content">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Kind="content" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="内容管理" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAccounts" Style="{StaticResource NavBtn}" GroupName="nav"
                                     Checked="OnNavChecked" Click="OnNavClick" Tag="accounts">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Kind="account" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="账号" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavBtn}" GroupName="nav"
                                     Checked="OnNavChecked" Click="OnNavClick" Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <local:IconView Kind="settings" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="设置" Margin="11,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 账号小卡 -->
                    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource SoftBg}"
                            BorderThickness="0" Padding="11,10" Margin="10,0,10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SideAvatar" Width="32" Height="32" CornerRadius="0"
                                    Background="{DynamicResource Green}" ClipToBounds="True">
                                <TextBlock x:Name="SideAvatarText" Text="G" Foreground="White" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SideAccName" Text="未登录" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SideAccType" Text="点击添加账号" Style="{DynamicResource Muted}" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 内容区（二级页面覆盖在上面） -->
                <Grid Grid.Column="1" Margin="10,0,16,14">
                    <ContentControl x:Name="Host" />
                    <Border x:Name="SecondaryPane" Visibility="Collapsed" Background="{DynamicResource WindowBgBrush}">
                        <ContentControl x:Name="SecondaryHost" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 启动遮罩（不显示日志） ================= -->
        <Border x:Name="LaunchMask" Visibility="Collapsed" Background="{DynamicResource MaskBrush}">
            <Border Style="{StaticResource GlassCard}" Width="380" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="MaskTitle" Text="正在启动游戏" Style="{StaticResource H2}" />
                    <TextBlock x:Name="MaskStep" Text="准备中…" Style="{DynamicResource Muted}" Margin="0,7,0,16" />
                    <ProgressBar x:Name="MaskBar" Height="6" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="MaskHint" Text="启动过程不显示日志，界面会在游戏就绪后自动返回"
                               Style="{DynamicResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= 运行状态（右下角） ================= -->
        <Border x:Name="RunChip" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,22" Style="{StaticResource GlassCard}" Padding="14,11" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Green}" VerticalAlignment="Center">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RunName" Text="Minecraft" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="RunTime" Text="00:00:00" Style="{StaticResource Mono}" FontSize="11" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="BtnStop" Content="结束进程" Style="{StaticResource BtnDanger}"
                        Padding="12,6" FontSize="12" Click="OnStopGame" />
            </Grid>
        </Border>

        <!-- ================= Toast ================= -->
        <Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,58,0,0" CornerRadius="10" Padding="16,9" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <TextBlock x:Name="ToastText" Text="" FontSize="12.5" />
        </Border>
    </Grid>
</Window>
